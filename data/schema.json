{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://njas.local/schema/item.json",
  "title": "NJAs archive item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "date",
    "date_type",
    "date_precision",
    "category",
    "entity",
    "title",
    "source_url",
    "verified"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(music|mv|tv|magazine|web|ad|tweet|goods|live|notice)-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$",
      "description": "一意ID。<category>-<YYYY-MM-DD>-<slug>"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "ソート用日付。date_precisionがmonthなら01日、yearなら01月01日を入れる"
    },
    "time": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
      "description": "同日内の並び順用の時刻（KST、24時間制）。不明なら省略"
    },
    "date_type": {
      "type": "string",
      "enum": [
        "release",
        "announce",
        "broadcast",
        "publish",
        "post",
        "sale_start",
        "event"
      ],
      "description": "release=発売/配信開始, announce=発表, broadcast=放送/配信, publish=発行, post=投稿, sale_start=販売開始, event=開催"
    },
    "date_precision": {
      "type": "string",
      "enum": [
        "day",
        "month",
        "year"
      ],
      "description": "日付の確定粒度"
    },
    "category": {
      "type": "string",
      "enum": [
        "music",
        "mv",
        "tv",
        "magazine",
        "web",
        "ad",
        "tweet",
        "goods",
        "live",
        "notice"
      ],
      "description": "notice=公式発表・声明・法的事象（ADOR/HYBE/裁判所/メンバー側の公式発表）"
    },
    "entity": {
      "type": "string",
      "enum": [
        "newjeans",
        "njz",
        "predebut"
      ],
      "description": "活動名義。newjeans=ADOR名義, njz=NJZ名義期間, predebut=デビュー前（HYBE/Source Music/ADOR/ミン・ヒジン関連）"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "all",
          "minji",
          "hanni",
          "danielle",
          "haerin",
          "hyein"
        ]
      },
      "default": [
        "all"
      ]
    },
    "title": {
      "type": "object",
      "required": [
        "ja",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "ja": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        },
        "original": {
          "type": "string",
          "description": "原題（韓国語等）"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ja": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      }
    },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ja": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      },
      "description": "詳細（2〜5文）。事実のみ。クレジット、収録曲、会場、出演内容、掲載内容など。その日付時点で分かることに限る"
    },
    "credits": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "クレジット。キー例：director, producer, composer, lyricist, choreographer, photographer, stylist, label, publisher, broadcaster, venue"
    },
    "source_url": {
      "type": "string",
      "pattern": "^https?://",
      "description": "一次ソース（公式サイト/公式SNS/公式YouTube等）のURL"
    },
    "reference_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https?://"
      },
      "description": "日付確認に用いた二次ソース"
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "youtube",
            "x",
            "image",
            "none"
          ]
        },
        "ref": {
          "type": "string",
          "description": "youtube=動画ID, x=投稿URL, image=media/以下の相対パス"
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^https?://"
      },
      "description": "外部リンク。キー例：spotify, apple_music, youtube_music, melon, weverse, official"
    },
    "local_assets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "media/以下の相対パス。切り抜きスキャン等の非公開素材"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "media/配下の相対パス（手動配置）"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://",
          "description": "取得元の画像URL。fetch_images.pyがmedia/auto/<id>.jpgに保存する"
        },
        "source_url": {
          "type": "string",
          "pattern": "^https?://",
          "description": "画像の出所ページ"
        }
      },
      "description": "代表画像の手動指定。自動取得より優先"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verified": {
      "type": "boolean",
      "description": "日付と内容を一次ソースで確認済みならtrue"
    },
    "note": {
      "type": "string",
      "description": "読者向けの補足。そのレコードの日付時点で分かることだけを書く（未来の出来事・日付を書かない）"
    },
    "editor_note": {
      "type": "string",
      "description": "編集者用メモ（出典の食い違い、未確認理由、作業履歴）。本モードでは表示しない"
    }
  }
}
