{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://njas.local/schema/item.json",
  "title": "NJAs archive item",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "date", "date_type", "date_precision", "category", "entity", "title", "source_url", "verified"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(music|mv|tv|magazine|web|ad|tweet|goods|live)-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$",
      "description": "一意ID。<category>-<YYYY-MM-DD>-<slug>"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "ソート用日付。date_precisionがmonthなら01日、yearなら01月01日を入れる"
    },
    "date_type": {
      "type": "string",
      "enum": ["release", "announce", "broadcast", "publish", "post", "sale_start", "event"],
      "description": "release=発売/配信開始, announce=発表, broadcast=放送/配信, publish=発行, post=投稿, sale_start=販売開始, event=開催"
    },
    "date_precision": {
      "type": "string",
      "enum": ["day", "month", "year"],
      "description": "日付の確定粒度"
    },
    "category": {
      "type": "string",
      "enum": ["music", "mv", "tv", "magazine", "web", "ad", "tweet", "goods", "live"]
    },
    "entity": {
      "type": "string",
      "enum": ["newjeans", "njz"],
      "description": "活動名義。newjeans=ADOR名義, njz=NJZ名義期間"
    },
    "members": {
      "type": "array",
      "items": {"type": "string", "enum": ["all", "minji", "hanni", "danielle", "haerin", "hyein"]},
      "default": ["all"]
    },
    "title": {
      "type": "object",
      "required": ["ja", "en"],
      "additionalProperties": false,
      "properties": {
        "ja": {"type": "string", "minLength": 1},
        "en": {"type": "string", "minLength": 1},
        "original": {"type": "string", "description": "原題（韓国語等）"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ja": {"type": "string"},
        "en": {"type": "string"}
      }
    },
    "source_url": {
      "type": "string",
      "pattern": "^https?://",
      "description": "一次ソース（公式サイト/公式SNS/公式YouTube等）のURL"
    },
    "reference_urls": {
      "type": "array",
      "items": {"type": "string", "pattern": "^https?://"},
      "description": "日付確認に用いた二次ソース"
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"type": "string", "enum": ["youtube", "x", "image", "none"]},
        "ref": {"type": "string", "description": "youtube=動画ID, x=投稿URL, image=media/以下の相対パス"}
      }
    },
    "local_assets": {
      "type": "array",
      "items": {"type": "string"},
      "description": "media/以下の相対パス。切り抜きスキャン等の非公開素材"
    },
    "tags": {
      "type": "array",
      "items": {"type": "string"}
    },
    "verified": {
      "type": "boolean",
      "description": "日付と内容を一次ソースで確認済みならtrue"
    },
    "note": {"type": "string"}
  }
}
